<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact — DudhDahi</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 60 60%22><text y=%2248%22 font-size=%2248%22>🥛</text></svg>">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

    <header class="site-header">
        <nav class="nav" id="mainNav">
            <a href="index" class="brand">
                <svg class="brand-mark" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><path d="M15 5h10v6l4 5v17a3 3 0 0 1-3 3H14a3 3 0 0 1-3-3V16l4-5V5Z" fill="var(--leaf)" /><path d="M12 20h16v11a3 3 0 0 1-3 3H15a3 3 0 0 1-3-3V20Z" fill="var(--gold)" /></svg>
                Dudh<span class="dahi">Dahi</span>
            </a>
            <ul class="nav-links">
                <li><a href="index">Home</a></li>
                <li><a href="products">Products</a></li>
                <li><a href="about">Our Farm</a></li>
                <li><a href="contact" aria-current="page">Contact</a></li>
            </ul>
            <div class="nav-actions">
                <a href="contact" class="btn btn-ghost btn-sm">Get in touch</a>
                <button class="cart-btn" id="cartToggle" aria-label="Open cart">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--leaf-deep)" stroke-width="1.8"><path d="M3 4h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6" /><circle cx="10" cy="21" r="1.4" /><circle cx="18" cy="21" r="1.4" /></svg>
                    <span class="cart-count">0</span>
                </button>
                <button class="nav-toggle" id="navToggle" aria-label="Toggle menu"><span></span></button>
            </div>
        </nav>
    </header>

    <div class="page-hero">
        <span class="eyebrow">We'd love to hear from you</span>
        <h1>Start your morning delivery.</h1>
        <p class="lede">Tell us where you are and what you'd like on your doorstep. Our team calls back within a day.</p>
    </div>

    <section class="section section-tight">
        <div class="contact-grid">
            <div class="contact-card" data-reveal>
                <h3 style="margin-bottom:22px;">Send us a message</h3>
                <form id="contactForm" novalidate>
                    <div class="field">
                        <label for="cf-name">Full name</label>
                        <input type="text" id="cf-name" name="name" placeholder="Your name">
                        <span class="field-error">Please enter your name.</span>
                    </div>
                    <div class="field">
                        <label for="cf-phone">Phone number</label>
                        <input type="tel" id="cf-phone" name="phone" placeholder="10-digit mobile number">
                        <span class="field-error">Enter a valid 10-digit phone number.</span>
                    </div>
                    <div class="field">
                        <label for="cf-email">Email address</label>
                        <input type="email" id="cf-email" name="email" placeholder="you@example.com">
                        <span class="field-error">Enter a valid email address.</span>
                    </div>
                    <div class="field">
                        <label for="cf-area">Delivery area</label>
                        <select id="cf-area" name="area">
                            <option>Sector 14, Gurugram</option>
                            <option>Sector 45, Gurugram</option>
                            <option>DLF Phase 1–5</option>
                            <option>South Delhi</option>
                            <option>Other — mention in message</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="cf-message">Message</label>
                        <textarea id="cf-message" name="message" placeholder="Tell us what you'd like delivered, and how often."></textarea>
                        <span class="field-error">Tell us a little more (min. 6 characters).</span>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">Send message</button>
                    <div class="form-msg" id="formMsg"></div>
                </form>
            </div>

            <div data-reveal>
                <h3>Other ways to reach us</h3>
                <div class="info-list">
                    <div class="info-item">
                        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.34 1.79.65 2.65a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.43-1.27a2 2 0 0 1 2.11-.45c.86.31 1.75.53 2.65.65A2 2 0 0 1 22 16.92Z" /></svg></div>
                        <div><h4>Call or WhatsApp</h4><p><a href="tel:+919876543210">+91 98765 43210</a></p></div>
                    </div>
                    <div class="info-item">
                        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4V4Z" /><path d="m4 6 8 7 8-7" /></svg></div>
                        <div><h4>Email</h4><p><a href="mailto:hello@dudhdahi.in">hello@dudhdahi.in</a></p></div>
                    </div>
                    <div class="info-item">
                        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z" /><circle cx="12" cy="10" r="3" /></svg></div>
                        <div><h4>Distribution hub</h4><p>Plot 12, Sector 14 Dairy Market, Gurugram, Haryana 122001</p></div>
                    </div>
                    <div class="info-item">
                        <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg></div>
                        <div><h4>Delivery window</h4><p>Every day, 6:00 AM – 7:30 AM</p></div>
                    </div>
                </div>
                <div class="map-frame">
                    <iframe src="https://www.google.com/maps?q=Sector%2014,%20Gurugram,%20Haryana&output=embed" loading="lazy" title="DudhDahi distribution hub location"></iframe>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-tight">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Good to know</span>
                <h2>Frequently asked questions.</h2>
            </div>
        </div>
        <div data-reveal>
            <div class="faq-item">
                <div class="faq-q"><span>Do you deliver every day, including Sundays?</span><span class="plus">+</span></div>
                <div class="faq-a"><div class="faq-a-inner">Yes — our vans run seven days a week, including Sundays and public holidays. The only pause is if you tell us to skip a day.</div></div>
            </div>
            <div class="faq-item">
                <div class="faq-q"><span>Can I pause or change my subscription anytime?</span><span class="plus">+</span></div>
                <div class="faq-a"><div class="faq-a-inner">Absolutely. Message us on WhatsApp before 9 PM the previous night to pause, add, or swap items for the next morning's delivery.</div></div>
            </div>
            <div class="faq-item">
                <div class="faq-q"><span>What areas do you currently cover?</span><span class="plus">+</span></div>
                <div class="faq-a"><div class="faq-a-inner">We currently deliver across Gurugram and parts of South Delhi. Mention your pin code in the form and we'll confirm coverage within a day.</div></div>
            </div>
            <div class="faq-item">
                <div class="faq-q"><span>Is there a minimum subscription period?</span><span class="plus">+</span></div>
                <div class="faq-a"><div class="faq-a-inner">No lock-in. You can start with a single trial delivery and move to a weekly or monthly plan whenever you're ready.</div></div>
            </div>
            <div class="faq-item">
                <div class="faq-q"><span>How do I pay?</span><span class="plus">+</span></div>
                <div class="faq-a"><div class="faq-a-inner">UPI, cards, and cash on delivery are all accepted. Monthly subscribers get a consolidated bill at the end of each cycle.</div></div>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <svg class="footer-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 30c240 30 480-30 720 0s480 30 720 0v30H0Z" fill="var(--bg)" /></svg>
        <div class="footer-grid">
            <div>
                <div class="footer-brand">
                    <svg width="26" height="26" viewBox="0 0 40 40"><path d="M15 5h10v6l4 5v17a3 3 0 0 1-3 3H14a3 3 0 0 1-3-3V16l4-5V5Z" fill="var(--gold)" /></svg>
                    Dudh<span style="color:var(--gold-soft)">Dahi</span>
                </div>
                <p>Farm-fresh dairy, collected at dawn and delivered before breakfast — across Gurugram and Delhi NCR.</p>
            </div>
            <div>
                <h4>Explore</h4>
                <ul>
                    <li><a href="products">All products</a></li>
                    <li><a href="about">Our farm story</a></li>
                    <li><a href="contact">Subscriptions</a></li>
                </ul>
            </div>
            <div>
                <h4>Categories</h4>
                <ul>
                    <li><a href="products">Milk</a></li>
                    <li><a href="products">Dahi &amp; Curd</a></li>
                    <li><a href="products">Ghee</a></li>
                    <li><a href="products">Chaas &amp; Cream</a></li>
                </ul>
            </div>
            <div>
                <h4>Get in touch</h4>
                <p>hello@dudhdahi.in<br>+91 98765 43210<br>Sector 14, Gurugram, Haryana</p>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 DudhDahi. All rights reserved.</span>
            <span>Made with care for small dairy farms.</span>
        </div>
    </footer>

    <div class="cart-overlay" id="cartOverlay"></div>
    <aside class="cart-drawer" id="cartDrawer" aria-label="Shopping cart">
        <div class="cart-head">
            <h3>Your basket</h3>
            <button class="cart-close" id="cartClose" aria-label="Close cart">✕</button>
        </div>
        <div class="cart-items" id="cartItems"></div>
        <div class="cart-foot">
            <div class="cart-total"><span>Total</span><span id="cartTotal">₹0</span></div>
            <a href="contact" class="btn btn-primary">Checkout via WhatsApp</a>
        </div>
    </aside>
    <div class="toast" id="toast"></div>

    <script src="~/js/script.js" asp-append-version="true"></script>
</body>
</html>