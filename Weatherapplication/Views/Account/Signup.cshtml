@model UserRegistration

@{
    ViewData["Title"] = "User Signup";
}

<!-- Bootstrap और Font Awesome Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
       /*  min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 0; */
    }

    .signup-container {
        perspective: 1000px;
    }

    .signup-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 24px;
        border: none;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        color: white;
        text-align: center;
        padding: 30px 20px;
        position: relative;
    }

    .brand-icon-mini {
        font-size: 2rem;
        margin-bottom: 10px;
        animation: float 3s ease-in-out infinite;
    }
    50% {
        transform: translateY(-5px);
    }

    100% {
        transform: translateY(0px);
    }

    }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        font-size: 0.85rem;
        margin-bottom: 6px;
    }

    .form-control {
        height: 45px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        padding-left: 15px;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

        .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
        }

    .btn-signup {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        border: none;
        height: 48px;
        border-radius: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        color: white;
        margin-top: 10px;
    }

        .btn-signup:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            transform: translateY(-1px);
            box-shadow: 0 7px 14px rgba(79, 70, 229, 0.3);
        }

    .login-link {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
    }

        .login-link:hover {
            text-decoration: underline;
        }
</style>

<div class="container signup-container">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-10">

            <div class="card shadow-lg signup-card">

                <!-- खूबसूरत ग्रेडीएंट हेडर मौसम आइकन के साथ -->
                <div class="card-header-custom">
                    <div class="brand-icon-mini">
                        <i class="fa-solid fa-cloud-sun"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Create Account</h3>
                    <p class="mb-0 text-white-50 small">Get started with your weather partner</p>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Signup" method="post">

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="John Doe" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mobile Number</label>
                            <input asp-for="MobileNo" class="form-control" placeholder="e.g. +91 9876543210" />
                            <span asp-validation-for="MobileNo" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-signup shadow-sm">
                                Register Now
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <p class="mb-0 small text-muted">Already have an account? <a href="/Login/LoginView" class="login-link">Sign In</a></p>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Registration Successful',
                text: '@TempData["Success"]',
                confirmButtonColor: '#4f46e5'
            });
        </script>
    }
}