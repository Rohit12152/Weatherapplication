@{
    ViewData["Title"] = "Customer Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid py-4" ng-app="ERPApp" ng-controller="CustomerController" ng-cloak>
    <style>
        /* आधुनिक और क्लीन इनपुट डिज़ाइन (Floating Label के साथ बेहतरीन कॉम्बिनेशन) */
        .custom-form .form-control,
        .custom-form .form-select {
            border: none;
            border-bottom: 2px solid #dee2e6;
            border-radius: 0;
            background-color: transparent;
            box-shadow: none;
            padding-left: 0;
            padding-right: 0;
            transition: border-color 0.3s ease;
        }

            .custom-form .form-control:focus,
            .custom-form .form-select:focus {
                border-bottom-color: #0d6efd;
                background-color: transparent;
                box-shadow: none;
            }

        /* फ़्लोटिंग लेबल की स्थिति सही करने के लिए */
        .custom-form .form-floating > label {
            padding-left: 0;
            color: #6c757d;
        }

        .custom-form .form-floating > .form-control:focus ~ label,
        .custom-form .form-floating > .form-control:not(:placeholder-shown) ~ label,
        .custom-form .form-floating > .form-select ~ label {
            color: #0d6efd;
            transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
        }

        /* कार्ड और हेडर की स्टाइलिंग */
        .custom-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }

        .card-header-gradient {
            background: linear-gradient(135deg, #0d6efd 0%, #0043a8 100%);
        }

        /* टेबल की स्टाइलिंग */
        .custom-table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .custom-table td {
            vertical-align: middle;
            font-size: 0.9rem;
        }

        [ng-cloak], .ng-cloak {
            display: none !important;
        }
        /* DataTables और Bootstrap का अलाइनमेंट ठीक करने के लिए */
        #itemTable {
            width: 100% !important;
            border-collapse: collapse !important;
        }

            #itemTable thead th {
                vertical-align: middle;
                white-space: nowrap;
            }

        /* DataTables द्वारा बनाए गए एक्स्ट्रा रैपर को सुंदर और रेस्पॉन्सिव बनाने के लिए */
        .dataTables_wrapper .row {
            margin-bottom: 1rem;
            align-items: center;
        }

        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #dee2e6 !important;
            border-radius: 6px !important;
            padding: 0.375rem 0.75rem !important;
            outline: none;
        }
    </style>

    <div class="card shadow custom-card custom-form mb-4" ng-if="ShowForm">
        <div class="card-header card-header-gradient text-white py-3 d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="fa-solid fa-user-plus me-2"></i>
                {{ Customer.partytype == 2 ? 'Supplier Master' : 'Customer Master' }}
            </h5>

            <div class="form-check form-switch mb-0 d-flex align-items-center">

                <input type="checkbox"
                       class="form-check-input me-2"
                       id="partyType"
                       ng-model="Customer.partytype"
                       ng-true-value="2"
                       ng-false-value="1">

                <label class="form-check-label text-white fw-bold mb-0" for="partyType">
                    {{ Customer.partytype == 2 ? 'Supplier' : 'Customer' }}
                </label>

            </div>

        </div>

        <div class="card-body p-4">
            <div class="row g-4 mb-4">

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               id="custCode"
                               placeholder=" "
                               ng-model="Customer.customerCode" />
                        <label for="custCode">
                            {{ Customer.partytype == 2 ? 'Supplier Code' : 'Customer Code' }}
                        </label>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               id="custName"
                               placeholder=" "
                               ng-model="Customer.customerName" />
                        <label for="custName">
                            {{ Customer.partytype == 2 ? 'Supplier Name' : 'Customer Name' }}
                        </label>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               id="compName"
                               placeholder=" "
                               ng-model="Customer.companyName" />
                        <label for="compName">Company Name</label>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text"
                               class="form-control"
                               id="contPerson"
                               placeholder=" "
                               ng-model="Customer.contactPerson" />
                        <label for="contPerson">Contact Person</label>
                    </div>
                </div>

            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="mobile" placeholder=" " ng-model="Customer.mobileNo" />
                        <label for="mobile">Mobile No</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="altMobile" placeholder=" " ng-model="Customer.alternateMobile" />
                        <label for="altMobile">Alternate Mobile</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="email" class="form-control" id="email" placeholder=" " ng-model="Customer.email" />
                        <label for="email">Email</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="gst" placeholder=" " ng-model="Customer.gstNo" />
                        <label for="gst">GST No</label>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="pan" placeholder=" " ng-model="Customer.panNo" />
                        <label for="pan">PAN No</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="aadhaar" placeholder=" " ng-model="Customer.aadhaarNo" />
                        <label for="aadhaar">Aadhaar No</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <select class="form-select" id="custType" ng-model="Customer.customerType">
                            <option value="">Select</option>
                            <option>Retail</option>
                            <option>Wholesale</option>
                            <option>Distributor</option>
                        </select>
                        <label for="custType">Customer Type</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="form-floating">
                        <input type="number" class="form-control" id="credit" placeholder=" " ng-model="Customer.creditLimit" />
                        <label for="credit">Credit Limit</label>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="payTerms" placeholder=" " ng-model="Customer.paymentTerms" />
                        <label for="payTerms">Payment Terms</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                    <div class="form-floating">
                        <input type="number" class="form-control" id="openBal" placeholder=" " ng-model="Customer.openingBalance" />
                        <label for="openBal">Opening Balance</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                    <div class="form-floating">
                        <select class="form-select" id="balType" ng-model="Customer.balanceType">
                            <option value="">Select</option>
                            <option>Dr</option>
                            <option>Cr</option>
                        </select>
                        <label for="balType">Balance Type</label>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6">
                    <div class="form-floating">
                        <textarea class="form-control" id="addr1" style="height: 80px" placeholder=" " ng-model="Customer.address1"></textarea>
                        <label for="addr1">Address 1</label>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-floating">
                        <textarea class="form-control" id="addr2" style="height: 80px" placeholder=" " ng-model="Customer.address2"></textarea>
                        <label for="addr2">Address 2</label>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="city" placeholder=" " ng-model="Customer.city" />
                        <label for="city">City</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="state" placeholder=" " ng-model="Customer.state" />
                        <label for="state">State</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="country" placeholder=" " ng-model="Customer.country" />
                        <label for="country">Country</label>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="pincode" placeholder=" " ng-model="Customer.pincode" />
                        <label for="pincode">Pincode</label>
                    </div>
                </div>
            </div>

            <div class="form-check form-switch mb-4 fs-6">
                <input class="form-check-input" type="checkbox" id="isActive" ng-model="Customer.isActive" />
                <label class="form-check-label text-muted" for="isActive">Active Status</label>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-start pt-2 border-top">
                <button class="btn btn-success px-4 py-2" ng-click="SaveCustomer()">
                    <i class="fa-solid fa-floppy-disk me-2"></i>{{ Customer.id ? 'Update' : 'Save' }}
                </button>
                <button class="btn btn-outline-secondary px-4 py-2" ng-click="Cancel()">
                    <i class="fa-solid fa-xmark me-2"></i>Cancel
                </button>
                <button class="btn btn-warning text-white px-4 py-2" ng-click="Clear()">
                    <i class="fa-solid fa-broom me-2"></i>Clear
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow custom-card" ng-if="ShowGrid">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                <h5 class="mb-0 text-secondary fw-bold text-uppercase tracking-wider">
                    <i class="fa-solid fa-list me-2 text-primary"></i>Customer List
                </h5>
                <button class="btn btn-primary px-3 py-2 d-flex align-items-center justify-content-center" ng-click="NewCustomer()">
                    <i class="fa fa-plus me-2"></i> New Customer
                </button>
            </div>

            <div class="table-responsive w-100">
                <table class="table table-hover align-middle custom-table w-100" id="itemTable">
                    <thead class="table-light border-bottom border-2 text-secondary">
                        <tr>
                            <th>Sr No.</th>
                            <th>Party Type</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Company</th>
                            <th>Mobile</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="c in CustomerList">
                            <td class="fw-bold text-secondary">{{$index + 1}}</td>
                            <td class="fw-bold text-dark">
                                {{ c.partytype == 1 ? 'Customer' : 'Supplier' }}
                              @*  {{ GetPartyType(c.partytype) }} *@
                            </td>
                            <td><span class="badge bg-light text-dark border">{{c.customerCode}}</span></td>
                            <td class="fw-semibold">{{c.customerName}}</td>
                            <td>{{c.companyName}}</td>
                            <td><i class="fa-solid fa-phone text-muted me-1 fs-7"></i> {{c.mobileNo}}</td>
                            <td>{{c.city}}</td>
                            <td>{{c.state}}</td>
                            <td class="fw-bold text-dark">{{c.openingBalance | number:2}}</td>
                            <td>
                                <span class="badge rounded-pill {{c.isActive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}} px-2.5 py-1.5 fs-7">
                                    {{c.isActive ? 'Active' : 'Inactive'}}
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-outline-primary btn-sm rounded-3 shadow-sm px-2" ng-click="Edit(c.id)" title="Edit">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm rounded-3 shadow-sm px-2" ng-click="Delete(c.id)" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/app.js"></script>
    <script src="~/js/Services/CustomerService.js"></script>
    <script src="~/js/Controllers/CustomerController.js"></script>
}