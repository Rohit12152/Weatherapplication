<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Inventory Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>

        body{
            background:#f4f7fc;
            font-family:'Segoe UI';
        }

        .dashboard-header{
            background:white;
            padding:20px;
            border-radius:15px;
            margin-bottom:20px;
            box-shadow:0 2px 10px rgba(0,0,0,.08);
        }

        .stat-card{
            border:none;
            border-radius:20px;
            color:white;
            overflow:hidden;
            transition:.3s;
        }

        .stat-card:hover{
            transform:translateY(-5px);
        }

        .sales{
            background:linear-gradient(135deg,#00c853,#64dd17);
        }

        .purchase{
            background:linear-gradient(135deg,#2962ff,#00b0ff);
        }

        .stock{
            background:linear-gradient(135deg,#ff6d00,#ffab00);
        }

        .profit{
            background:linear-gradient(135deg,#7b1fa2,#e040fb);
        }

        .stat-card .card-body{
            padding:25px;
        }

        .stat-card i{
            font-size:40px;
            opacity:.3;
            float:right;
        }

        .custom-card{
            background:#fff;
            border:none;
            border-radius:20px;
            box-shadow:0 2px 15px rgba(0,0,0,.08);
        }

        .card-title{
            font-weight:600;
        }

        .table th{
            background:#1f2937;
            color:white;
        }

        .progress{
            height:10px;
        }

        .badge-stock{
            background:red;
        }

        .badge-good{
            background:green;
        }

    </style>
</head>

<body>

    <div class="container-fluid p-4">

        <div class="dashboard-header d-flex justify-content-between">
            <div>
                <h3>Inventory Dashboard</h3>
                <small>Sales • Purchase • Stock Management</small>
            </div>

            <button class="btn btn-primary">
                <i class="fa fa-file"></i> Export Report
            </button>
        </div>

        <!-- Cards -->

        <div class="row g-4">

            <div class="col-lg-3">
                <div class="card stat-card sales">
                    <div class="card-body">
                        <i class="fa fa-chart-line"></i>
                        <h6>Total Sales</h6>
                        <h2>₹12.5L</h2>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card stat-card purchase">
                    <div class="card-body">
                        <i class="fa fa-cart-shopping"></i>
                        <h6>Total Purchase</h6>
                        <h2>₹9.2L</h2>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card stat-card stock">
                    <div class="card-body">
                        <i class="fa fa-boxes-stacked"></i>
                        <h6>Total Stock</h6>
                        <h2>15,250</h2>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card stat-card profit">
                    <div class="card-body">
                        <i class="fa fa-indian-rupee-sign"></i>
                        <h6>Profit</h6>
                        <h2>₹3.3L</h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Charts -->

        <div class="row mt-4">

            <div class="col-lg-4">

                <div class="card custom-card">
                    <div class="card-body">
                        <h5 class="card-title">Sales vs Purchase</h5>

                        <canvas id="pieChart"></canvas>

                    </div>
                </div>

            </div>

            <div class="col-lg-8">

                <div class="card custom-card">
                    <div class="card-body">
                        <h5 class="card-title">Monthly Sales Trend</h5>

                        <canvas id="lineChart"></canvas>

                    </div>
                </div>

            </div>

        </div>

        <!-- Stock + Top Items -->

        <div class="row mt-4">

            <div class="col-lg-6">

                <div class="card custom-card">
                    <div class="card-body">

                        <h5>Top Selling Products</h5>

                        <table class="table table-hover mt-3">
                            <tr>
                                <th>Item</th>
                                <th>Qty Sold</th>
                            </tr>

                            <tr>
                                <td>Shirt</td>
                                <td>520</td>
                            </tr>

                            <tr>
                                <td>Jeans</td>
                                <td>430</td>
                            </tr>

                            <tr>
                                <td>T-Shirt</td>
                                <td>350</td>
                            </tr>
                        </table>

                    </div>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="card custom-card">
                    <div class="card-body">

                        <h5>Low Stock Alerts</h5>

                        <div class="mt-4">

                            Shirt XL
                            <div class="progress mb-3">
                                <div class="progress-bar bg-danger" style="width:15%"></div>
                            </div>

                            Jeans 32
                            <div class="progress mb-3">
                                <div class="progress-bar bg-warning" style="width:25%"></div>
                            </div>

                            Jacket M
                            <div class="progress">
                                <div class="progress-bar bg-danger" style="width:10%"></div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>

        <!-- Recent Transactions -->

        <div class="row mt-4">

            <div class="col-lg-6">

                <div class="card custom-card">
                    <div class="card-body">

                        <h5>Recent Sales</h5>

                        <table class="table">
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Amount</th>
                            </tr>

                            <tr>
                                <td>INV001</td>
                                <td>Rahul</td>
                                <td>₹5000</td>
                            </tr>

                            <tr>
                                <td>INV002</td>
                                <td>Amit</td>
                                <td>₹7500</td>
                            </tr>

                        </table>

                    </div>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="card custom-card">
                    <div class="card-body">

                        <h5>Recent Purchases</h5>

                        <table class="table">
                            <tr>
                                <th>PO No</th>
                                <th>Vendor</th>
                                <th>Amount</th>
                            </tr>

                            <tr>
                                <td>PO001</td>
                                <td>ABC Traders</td>
                                <td>₹20000</td>
                            </tr>

                            <tr>
                                <td>PO002</td>
                                <td>XYZ Traders</td>
                                <td>₹15000</td>
                            </tr>

                        </table>

                    </div>
                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        new Chart(document.getElementById('pieChart'),{
            type:'pie',
            data:{
                labels:['Sales','Purchase'],
                datasets:[{
                    data:[1250000,920000]
                }]
            }
        });

        new Chart(document.getElementById('lineChart'),{
            type:'line',
            data:{
                labels:['Jan','Feb','Mar','Apr','May','Jun'],
                datasets:[{
                    label:'Sales',
                    data:[120000,150000,180000,220000,250000,300000]
                }]
            }
        });

    </script>

</body>
</html>