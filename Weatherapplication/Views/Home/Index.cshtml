<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Inventory Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>

        body {
            background: #f4f7fc;
            font-family: 'Segoe UI';
        }

        .dashboard-header {
            background: #fff;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

        .stat-card {
            border: none;
            border-radius: 20px;
            color: #fff;
            overflow: hidden;
            transition: .3s;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .sales {
            background: linear-gradient(135deg,#00c853,#64dd17);
        }

        .purchase {
            background: linear-gradient(135deg,#2962ff,#00b0ff);
        }

        .stock {
            background: linear-gradient(135deg,#ff6d00,#ffab00);
        }

        .profit {
            background: linear-gradient(135deg,#7b1fa2,#e040fb);
        }

        .stat-card .card-body {
            padding: 25px;
        }

        .stat-card i {
            font-size: 42px;
            opacity: .25;
            float: right;
        }

        .custom-card {
            border: none;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 2px 15px rgba(0,0,0,.08);
        }

        .table th {
            background: #1f2937;
            color: #fff;
        }

        .progress {
            height: 10px;
        }

        .chart-box {
            height: 300px;
            position: relative;
        }

        .custom-card {
            border: none;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 2px 15px rgba(0,0,0,.08);
        }

        .card-body h5 {
            font-size: 16px;
            font-weight: 600;
        }

    </style>
</head>

<body>

    <div class="container-fluid p-4">

        <!-- Header -->

        <div class="dashboard-header">

            <div class="row align-items-center">

                <div class="col-md-6">
                    <h3>Inventory Dashboard</h3>
                    <small>Sales • Purchase • Stock Management</small>
                </div>

                <div class="col-md-3">
                    <select id="dashboardFilter" class="form-select">
                        <option value="today">Today</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly" selected>Monthly</option>
                    </select>
                </div>

                <div class="col-md-3 text-end">
                    <button class="btn btn-primary">
                        <i class="fa fa-file-export"></i> Export Report
                    </button>
                </div>

            </div>

        </div>

        <!-- KPI Cards -->

        <div class="row g-4">

            <div class="col-lg-3">
                <div class="card stat-card sales">
                    <div class="card-body">
                        <i class="fa fa-chart-line"></i>
                        <h6>Total Sales</h6>
                        <h2 id="salesAmount"></h2>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card stat-card purchase">
                    <div class="card-body">
                        <i class="fa fa-cart-shopping"></i>
                        <h6>Total Purchase</h6>
                        <h2 id="purchaseAmount">₹9,20,000</h2>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card stat-card stock">
                    <div class="card-body">
                        <i class="fa fa-boxes-stacked"></i>
                        <h6>Total Stock</h6>
                        <h2 id="stockAmount">15,250</h2>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card stat-card profit">
                    <div class="card-body">
                        <i class="fa fa-indian-rupee-sign"></i>
                        <h6>Profit</h6>
                        <h2 id="profitAmount">₹3,30,000</h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Charts Row -->

        <div class="row mt-4 g-4">

            <!-- Pie Chart -->

            <div class="col-lg-4">

                <div class="card custom-card h-100">
                    <div class="card-body">

                        <h5 class="mb-3">Sales vs Purchase</h5>

                        <div class="chart-box">
                            <canvas id="pieChart"></canvas>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Line Chart -->

            <div class="col-lg-4">

                <div class="card custom-card h-100">
                    <div class="card-body">

                        <h5 class="mb-3">Sales Trend</h5>

                        <div class="chart-box">
                            <canvas id="lineChart"></canvas>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Bar Chart -->

            <div class="col-lg-4">

                <div class="card custom-card h-100">
                    <div class="card-body">

                        <h5 class="mb-3">Top Selling Products</h5>

                        <div class="chart-box">
                            <canvas id="barChart"></canvas>
                        </div>

                    </div>
                </div>

            </div>

        </div>

        <!-- Stock Alert + Recent Sales -->

        <div class="row mt-4">

            <div class="col-lg-6">

                <div class="card custom-card">
                    <div class="card-body">

                        <h5>Low Stock Alerts</h5>

                        Shirt XL
                        <div class="progress mb-3">
                            <div class="progress-bar bg-danger" style="width:15%"></div>
                        </div>

                        Jeans 32
                        <div class="progress mb-3">
                            <div class="progress-bar bg-warning" style="width:25%"></div>
                        </div>

                        Jacket M
                        <div class="progress">
                            <div class="progress-bar bg-danger" style="width:10%"></div>
                        </div>

                    </div>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="card custom-card">
                    <div class="card-body">

                        <h5>Recent Sales</h5>

                        <table class="table table-hover">

                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Amount</th>
                            </tr>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SalesNo</td>
                                    <td>@item.StudentName</td>
                                    <td>
                                        ₹ @String.Format("{0:N2}", item.NetAmount)
                                    </td>
                                </tr>
                            }
                        </table>

                    </div>
                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

               $(document).ready(function () {

            // PIE CHART
            const pieChart = new Chart(document.getElementById('pieChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Sales', 'Purchase'],
                    datasets: [{
                        data: [0, 0],
                        backgroundColor: [
                            '#00c853',
                            '#2962ff'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            // LINE CHART (Static)
            const lineChart = new Chart(document.getElementById('lineChart'), {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Sales',
                        data: [120000, 150000, 180000, 220000, 250000, 300000],
                        borderColor: '#2962ff',
                        backgroundColor: 'rgba(41,98,255,0.15)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            // BAR CHART (Static)
            const barChart = new Chart(document.getElementById('barChart'), {
                type: 'bar',
                data: {
                    labels: ['Shirt', 'Jeans', 'T-Shirt', 'Jacket'],
                    datasets: [{
                        label: 'Qty Sold',
                        data: [520, 430, 350, 290],
                        backgroundColor: [
                            '#00c853',
                            '#2962ff',
                            '#ff6d00',
                            '#7b1fa2'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            loadDashboard("monthly");

            $("#dashboardFilter").change(function () {

                loadDashboard($(this).val());

            });

            function loadDashboard(filter) {

                $.ajax({

                    url: '/Home/GetDashboardData',
                    type: 'GET',
                    data: { filter: filter },

                    success: function (res) {

                        $("#salesAmount").text("₹" + Number(res.totalSales).toLocaleString());
                        $("#purchaseAmount").text("₹" + Number(res.totalPurchase).toLocaleString());
                        $("#stockAmount").text("₹" + Number(res.totalStock).toLocaleString());
                        $("#profitAmount").text("₹" + Number(res.profit).toLocaleString());

                        // Update Pie Chart
                        pieChart.data.datasets[0].data = [
                            Number(res.totalSales),
                            Number(res.totalPurchase)
                        ];

                        pieChart.update();

                    },

                    error: function (xhr) {

                        console.log(xhr.responseText);

                    }

                });

            }

        });
    </script>

</body>
</html>