@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Sales List";
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <div class="row">
                <div class="col-md-6">
                    <h4>Sales List</h4>
                </div>

                <div class="col-md-6 text-end">
                    <a asp-action="Create"
                       class="btn btn-light">
                        + New Sales
                    </a>
                </div>
            </div>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Sales No</th>
                        <th>Quotation Ref</th>
                        <th>Student</th>
                        <th>Date</th>
                        <th>Net Amount</th>
                        <th width="180">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.SalesNo</td>

                            <td>@item.ReferenceQuotationNo</td>

                            <td>@item.StudentName</td>

                            <td>
                                @(item.SalesDate == null
                                                            ? ""
                                                            : Convert.ToDateTime(item.SalesDate).ToString("dd/MM/yyyy"))
                        </td>

                            <td>
                                ₹ @String.Format("{0:N2}", item.NetAmount)
                            </td>

                            <td>

                              @*   <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    View
                                </a> *@

                                <a asp-action="Create"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    <i class="fa fa-pen"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Delete this Sales Record ?')">
                                    <i class="fa fa-trash"></i>
                                </a>

                            </td>

                        </tr>
                                        }

                </tbody>

            </table>

        </div>

    </div>

</div>
<script>
    $(document).ready(function () {

        if ($.fn.DataTable) {

            $('#itemTable').DataTable({
                responsive: true,
                scrollX: true
            });

        }

    });

    function DeleteQuotation(id) {

        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to recover this item!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete it!'
        }).then((result) => {

            if (result.isConfirmed) {
                window.location.href = '/Quotation/Delete/' + id;
            }

        });
    }
</script>
@if (TempData["success"] != null)
{
    <script>

        Swal.fire({

            icon: 'success',

            title: 'Success',

            text: '@TempData["success"]',

            timer: 2000,

            showConfirmButton: false

        });

    </script>
}