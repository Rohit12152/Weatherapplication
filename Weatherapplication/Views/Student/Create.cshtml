@model Weatherapplication.Models.StudentDetails
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<h2>
    @(Model.Id == 0 ? "Add Student" : "Update Student")
</h2>

<form asp-action="Create" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label>Student Name</label>

        <input asp-for="StudentName"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>Email</label>

        <input asp-for="Email"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>Mobile</label>

        <input asp-for="Mobile"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>Course</label>

        <input asp-for="Course"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-primary">

        @(Model.Id == 0 ? "Save" : "Update")

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>