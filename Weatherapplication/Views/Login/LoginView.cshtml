@model Weatherapplication.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
       /*  min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center; */
    }

    .login-container {
        perspective: 1000px;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 24px;
        border: none;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease;
    }

    .brand-icon {
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: white;
        font-size: 24px;
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
    }

    .form-label {
        font-weight: 600;
        color: #4a5568;
        font-size: 0.9rem;
    }

    .form-control {
        height: 48px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        padding-left: 15px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
        }

    .btn-login {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        border: none;
        height: 48px;
        border-radius: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        color: white;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            transform: translateY(-1px);
            box-shadow: 0 7px 14px rgba(79, 70, 229, 0.3);
        }

    .signup-link {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
    }

        .signup-link:hover {
            text-decoration: underline;
        }
</style>

<div class="container login-container">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

            <div class="card login-card p-3">
                <div class="card-body">

                    <div class="brand-icon">
                        <i class="fa-solid fa-cloud-sun-rain"></i>
                    </div>

                    <h3 class="text-center fw-bold mb-1" style="color: #1e293b;">Welcome Back</h3>
                    <p class="text-center text-muted small mb-4">Please enter your details to sign in</p>

                    <form asp-action="Login" method="post">
                        @* Action Method ka naam hota hai Login *@

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label">Password</label>
                            </div>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-login shadow-sm">
                                Sign In
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <p class="mb-0 small text-muted">Don't have an account? <a href="/Account/Signup" class="signup-link">Create one</a></p>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '@TempData["Success"]',
            confirmButtonColor: '#4f46e5'
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Login Failed',
            text: '@TempData["Error"]',
            confirmButtonColor: '#4f46e5'
        });
    </script>
}