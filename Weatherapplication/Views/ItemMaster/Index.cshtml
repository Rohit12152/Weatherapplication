

@{
    ViewData["Title"] = "Item Master";
}


<style>
    .dt-buttons {
        margin-bottom: 10px;
    }

    .action-btns {
        display: flex;
        gap: 5px;
    }

    @@media (max-width:768px) {

        h2 {
            text-align: center;
            font-size: 24px;
        }

        #itemTable {
            font-size: 12px;
        }

        .dt-buttons .btn {
            margin-bottom: 5px;
        }

        .action-btns {
            justify-content: center;
        }

        .btn-mobile {
            width: 100%;
        }
    }
</style>
<div class="container-fluid">

    <h2 class="mb-3">Item Master</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fa fa-plus"></i> Add Item
        </a>
    </div>
    <form asp-action="UploadExcel"
          method="post"
          enctype="multipart/form-data">

        <div class="row g-2 mb-3">

            <div class="col-lg-4 col-md-4 col-12">

                <input type="file"
                       name="file"
                       class="form-control"
                       accept=".xls,.xlsx" />

            </div>

            <div class="col-lg-2 col-md-3 col-12">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fa fa-upload"></i>
                    Upload Excel

                </button>

            </div>

            <div class="col-lg-3 col-md-4 col-12">

                <a href="~/ItemExcel/DFCB3100.xlsx"
                   class="btn btn-success w-100"
                   download>

                    <i class="fa fa-download"></i>
                    Download Sample Excel

                </a>

            </div>

        </div>

    </form>
    <div class="table-responsive">

        <table id="itemTable" class="table table-bordered table-striped nowrap w-100">

            <thead class="table-dark">

                <tr>
                    <th>Category</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Unit</th>
                    <th>Purchase</th>
                    <th>Sale</th>
                    <th>GST</th>
                    <th>Stock</th>
                    <th>Brand</th>
                    <th>Action</th>
                </tr>

            </thead>

        </table>

    </div>

</div>



<script>

    $(document).ready(function () {

        $('#itemTable').DataTable({

            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            scrollX: true,

            ajax: {

                url: '/ItemMaster/GetItems',
                type: 'POST'

            },

            columns: [

                { data: 'categoryName' },
                { data: 'itemCode' },
                { data: 'itemName' },
                // { data: 'category' },
                { data: 'unit' },
                { data: 'purchaseRate' },
                { data: 'saleRate' },
                { data: 'gst' },
                { data: 'openingStock' },
                { data: 'brand' },

                {
                    data: 'id',
                    render: function (data) {

                        return `
                            <div class="action-btns">

                                <a href="/ItemMaster/Create/${data}"
                                   class="btn btn-warning btn-sm">
                                   <i class="fa fa-pen"></i>
                                </a>

                                <a href="javascript:void(0)"
                                   onclick="DeleteItem(${data})"
                                   class="btn btn-danger btn-sm">
                                   <i class="fa fa-trash"></i>
                                </a>

                            </div>`;
                    }
                }

            ],
            dom: 'Bfrtip',
             buttons: [

                {
                    extend: 'copy',
                    text: '<i class="fa fa-copy"></i> Copy',
                    className: 'btn btn-secondary'
                },

                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel"></i> Excel',
                    className: 'btn btn-success'
                },

                {
                    extend: 'pdf',
                    text: '<i class="fa fa-file-pdf"></i> PDF',
                    className: 'btn btn-danger'
                },

                {
                    extend: 'print',
                    text: '<i class="fa fa-print"></i> Print',
                    className: 'btn btn-primary'
                }

            ]
        });
       
    });

    function DeleteItem(id) {

        Swal.fire({

            title: 'Are you sure?',
            text: "You won't be able to recover this item!",
            icon: 'warning',
            showCancelButton: true

        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href = '/ItemMaster/Delete/' + id;

            }

        });

    }

</script>
@if (TempData["success"] != null)
{
    <script>

        Swal.fire({

            icon: 'success',

            title: 'Success',

            text: '@TempData["success"]',

            timer: 2000,

            showConfirmButton: false

        });

    </script>
}