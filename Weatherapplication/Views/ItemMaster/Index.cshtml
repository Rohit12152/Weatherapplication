@* @model IEnumerable<Weatherapplication.Models.ItemMaster>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .dt-buttons {
        margin-bottom: 10px;
    }

    .action-btns {
        display: flex;
        gap: 5px;
    }

    @@media (max-width:768px) {

        h2 {
            text-align: center;
            font-size: 24px;
        }

        #itemTable {
            font-size: 12px;
        }

        .dt-buttons .btn {
            margin-bottom: 5px;
        }

        .action-btns {
            justify-content: center;
        }

        .btn-mobile {
            width: 100%;
        }
    }
</style>

<div class="container-fluid">

    <h2 class="mb-3">Item Master</h2>

    <div class="mb-3">

        <a asp-action="Create"
           class="btn btn-success btn-mobile">

            <i class="fa fa-plus"></i>
            Add Item

        </a>

    </div>

    <form asp-action="UploadExcel"
          method="post"
          enctype="multipart/form-data">

        <div class="row g-2 mb-3">

            <div class="col-lg-4 col-md-4 col-12">

                <input type="file"
                       name="file"
                       class="form-control"
                       accept=".xls,.xlsx" />

            </div>

            <div class="col-lg-2 col-md-3 col-12">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fa fa-upload"></i>
                    Upload Excel

                </button>

            </div>

            <div class="col-lg-3 col-md-4 col-12">

                <a href="~/ItemExcel/DFCB3100.xlsx"
                   class="btn btn-success w-100"
                   download>

                    <i class="fa fa-download"></i>
                    Download Sample Excel

                </a>

            </div>

        </div>

    </form>

    <div class="table-responsive">

        <table class="table table-bordered table-striped nowrap w-100"
               id="itemTable">

            <thead class="table-dark">

                <tr>

                    <th>Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Unit</th>
                    <th>Purchase</th>
                    <th>Sale</th>
                    <th>GST</th>
                    <th>Stock</th>
                    <th>Brand</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.Category</td>
                        <td>@item.Unit</td>
                        <td>@item.PurchaseRate</td>
                        <td>@item.SaleRate</td>
                        <td>@item.GST</td>
                        <td>@item.OpeningStock</td>
                        <td>@item.Brand</td>

                        <td>

                            <div class="action-btns">

                                <a asp-action="Create"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fa fa-pen"></i>

                                </a>

                                <a href="javascript:void(0)"
                                   onclick="DeleteItem(@item.Id)"
                                   class="btn btn-danger btn-sm">

                                    <i class="fa fa-trash"></i>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>

<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

<script>

    $(document).ready(function () {

        $('#itemTable').DataTable({

            responsive: true,

            scrollX: true,

            paging: true,

            searching: true,

            ordering: true,

            info: true,

            pageLength: 10,

            dom: 'Bfrtip',

            buttons: [

                {
                    extend: 'copy',
                    text: '<i class="fa fa-copy"></i> Copy',
                    className: 'btn btn-secondary'
                },

                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel"></i> Excel',
                    className: 'btn btn-success'
                },

                {
                    extend: 'pdf',
                    text: '<i class="fa fa-file-pdf"></i> PDF',
                    className: 'btn btn-danger'
                },

                {
                    extend: 'print',
                    text: '<i class="fa fa-print"></i> Print',
                    className: 'btn btn-primary'
                }

            ]

        });

    });

    function DeleteItem(id) {

        Swal.fire({

            title: 'Are you sure?',

            text: "You won't be able to recover this item!",

            icon: 'warning',

            showCancelButton: true,

            confirmButtonColor: '#d33',

            cancelButtonColor: '#3085d6',

            confirmButtonText: 'Yes Delete'

        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href = '/ItemMaster/Delete/' + id;

            }

        });

    }

</script>

@if (TempData["success"] != null)
{
    <script>

        Swal.fire({

            icon: 'success',

            title: 'Success',

            text: '@TempData["success"]',

            timer: 2000,

            showConfirmButton: false

        });

    </script>
} *@

@{
    ViewData["Title"] = "Item Master";
}


<style>
    .dt-buttons {
        margin-bottom: 10px;
    }

    .action-btns {
        display: flex;
        gap: 5px;
    }

    @@media (max-width:768px) {

        h2 {
            text-align: center;
            font-size: 24px;
        }

        #itemTable {
            font-size: 12px;
        }

        .dt-buttons .btn {
            margin-bottom: 5px;
        }

        .action-btns {
            justify-content: center;
        }

        .btn-mobile {
            width: 100%;
        }
    }
</style>
<div class="container-fluid">

    <h2 class="mb-3">Item Master</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fa fa-plus"></i> Add Item
        </a>
    </div>
    <form asp-action="UploadExcel"
          method="post"
          enctype="multipart/form-data">

        <div class="row g-2 mb-3">

            <div class="col-lg-4 col-md-4 col-12">

                <input type="file"
                       name="file"
                       class="form-control"
                       accept=".xls,.xlsx" />

            </div>

            <div class="col-lg-2 col-md-3 col-12">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fa fa-upload"></i>
                    Upload Excel

                </button>

            </div>

            <div class="col-lg-3 col-md-4 col-12">

                <a href="~/ItemExcel/DFCB3100.xlsx"
                   class="btn btn-success w-100"
                   download>

                    <i class="fa fa-download"></i>
                    Download Sample Excel

                </a>

            </div>

        </div>

    </form>
    <div class="table-responsive">

        <table id="itemTable" class="table table-bordered table-striped nowrap w-100">

            <thead class="table-dark">

                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Unit</th>
                    <th>Purchase</th>
                    <th>Sale</th>
                    <th>GST</th>
                    <th>Stock</th>
                    <th>Brand</th>
                    <th>Action</th>
                </tr>

            </thead>

        </table>

    </div>

</div>



<script>

    $(document).ready(function () {

        $('#itemTable').DataTable({

            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            scrollX: true,

            ajax: {

                url: '/ItemMaster/GetItems',
                type: 'POST'

            },

            columns: [

                { data: 'itemCode' },
                { data: 'itemName' },
                { data: 'category' },
                { data: 'unit' },
                { data: 'purchaseRate' },
                { data: 'saleRate' },
                { data: 'gst' },
                { data: 'openingStock' },
                { data: 'brand' },

                {
                    data: 'id',
                    render: function (data) {

                        return `
                            <div class="action-btns">

                                <a href="/ItemMaster/Create/${data}"
                                   class="btn btn-warning btn-sm">
                                   <i class="fa fa-pen"></i>
                                </a>

                                <a href="javascript:void(0)"
                                   onclick="DeleteItem(${data})"
                                   class="btn btn-danger btn-sm">
                                   <i class="fa fa-trash"></i>
                                </a>

                            </div>`;
                    }
                }

            ],
            dom: 'Bfrtip',
             buttons: [

                {
                    extend: 'copy',
                    text: '<i class="fa fa-copy"></i> Copy',
                    className: 'btn btn-secondary'
                },

                {
                    extend: 'excel',
                    text: '<i class="fa fa-file-excel"></i> Excel',
                    className: 'btn btn-success'
                },

                {
                    extend: 'pdf',
                    text: '<i class="fa fa-file-pdf"></i> PDF',
                    className: 'btn btn-danger'
                },

                {
                    extend: 'print',
                    text: '<i class="fa fa-print"></i> Print',
                    className: 'btn btn-primary'
                }

            ]
        });
       
    });

    function DeleteItem(id) {

        Swal.fire({

            title: 'Are you sure?',
            text: "You won't be able to recover this item!",
            icon: 'warning',
            showCancelButton: true

        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href = '/ItemMaster/Delete/' + id;

            }

        });

    }

</script>
@if (TempData["success"] != null)
{
    <script>

        Swal.fire({

            icon: 'success',

            title: 'Success',

            text: '@TempData["success"]',

            timer: 2000,

            showConfirmButton: false

        });

    </script>
}